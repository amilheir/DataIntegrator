#####################################################
#        IRIS AI ETL/ELT Wizard Builder             #
#               CONFIG ENV FILE                     #
#####################################################

# AI Hub EAP image. Load it first:
#   docker image load -i ./src-iris/iris-2026.3.0AI.136.0-docker.tar.gz
# then confirm the tag with `docker images`.
# Enterprise (non-community) build — needs src-iris/iris.key, copied in by the Dockerfile.
IRIS_IMAGE="docker.iscinternal.com/docker-intersystems/intersystems/iris:2026.3.0AI.136.0"

IRIS_SPORT=51972
IRIS_PORT=52773
OLLAMA_PORT=11434
# Pinned, not :latest — ornith:9b needs >= 0.31 to pull ("412: requires a newer
# version of Ollama"), and :latest on a host with a stale cached image silently
# gives you 0.30.10 instead.
OLLAMA_IMAGE="ollama/ollama:0.32.14"

IRISUSERNAME="_SYSTEM"
IRISPASSWORD="SYS"
IRISNAMESPACE=DATAINTEGRATOR

# Web Gateway (HTTP front end — the AI Hub community image has no private web server)
# Pinned by DIGEST, not latest-preview (IMPROVEMENTS_SPEC DS-2): a moving tag
# is not reproducible, and the demo machine must bring up the same front end
# tomorrow that it brought up today. This digest is the latest-preview image
# this stack is verified working on — pinning it changes nothing about what
# runs, only about what a future `pull` would silently substitute.
WEBGATEWAY_IMAGE="containers.intersystems.com/intersystems/webgateway:latest-preview"

#####################################################
# Credential material — kept OUTSIDE the project tree
#####################################################
# Neither file may live under the project directory: both are one screen-share
# of a file manager or a terminal away from an audience (IMPROVEMENTS_SPEC
# SG-2). They are passed to the build as Docker secrets, never COPYed from the
# build context.
#
# IRIS_KEY_PATH must be a Container(...) platform key. An "all non-container"
# key is rejected inside Docker with "license file invalid for this platform",
# and every REST/dispatch web app then answers 503.
IRIS_KEY_PATH="C:/InterSystems/DataIntegrator/secrets/iris-container.key"
IRIS_PW_FILE="C:/InterSystems/DataIntegrator/secrets/irispw.txt"
