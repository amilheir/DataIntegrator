/// REST ingestion tools (spec §10.2, §6.2 REST exception): REST APIs do NOT
/// use Foreign Tables — the wizard generates a visible ObjectScript client
/// class that pages through the source (cursor pagination) and lands raw
/// JSON into ETLW_LANDING.<base>_rest_raw. GenerateRestClient and
/// RunRestCursorLoad are approval-gated via the Policy.Auth verb list.
Class ETLWizard.Tools.RestIngestion Extends %AI.Tool [ DependsOn = ETLWizard.Tools.Util ]
{

/// Store the REST source configuration for this pipeline as a rest_client
/// catalog node. serverHost/serverPort/path address the API
/// (e.g. webgateway / 80 / /etlwizard/api/demo/customers for the demo);
/// cursorParam+cursorField implement next-cursor pagination; dataPath is the
/// JSON array property holding the items.
Method StoreRestConfig(runId As %String, baseName As %String, serverHost As %String, serverPort As %Integer, path As %String, cursorParam As %String = "after", sizeParam As %String = "size", pageSize As %Integer = 4, dataPath As %String = "data", cursorField As %String = "nextCursor", idField As %String = "customer_id") As %String
{
    Try {
        If '##class(ETLWizard.Tools.Util).ValidIdent(baseName) {
            Return "ERROR: invalid baseName"
        }
        If (path '? 1"/".E) || (path [ "'") || (path [ " ") {
            Return "ERROR: path must start with / and contain no spaces or quotes"
        }
        Set config = {"serverHost": (serverHost), "serverPort": (serverPort), "path": (path),
                      "cursorParam": (cursorParam), "sizeParam": (sizeParam), "pageSize": (pageSize),
                      "dataPath": (dataPath), "cursorField": (cursorField), "idField": (idField)}
        Return ##class(ETLWizard.Tools.Util).CatalogNode(runId, "rest_client",
            baseName _ "_rest_source", "", config.%ToJSON())
    } Catch ex {
        Return "ERROR: " _ ex.DisplayString()
    }
}

/// One bounded call against the stored REST config (first page only) so the
/// user can see exactly what the source returns before generating anything.
Method TestRestCall(runId As %String, baseName As %String) As %String
{
    Try {
        Set err = ..GetConfig(runId, baseName, .cfg)
        If err '= "" {
            Return err
        }
        Set err = ..FetchPage(cfg, 0, .items, .nextCursor)
        If err '= "" {
            Return err
        }
        Return {"items": (items), "nextCursor": (nextCursor)}.%ToJSON()
    } Catch ex {
        Return "ERROR: " _ ex.DisplayString()
    }
}

/// Generate and compile the ObjectScript REST client class
/// ETLWizard.Gen.Rest<base> from the stored config. The class source is
/// recorded on the rest_client node (SqlText) so it is fully inspectable
/// and re-runnable without the agent (spec §1.1).
Method GenerateRestClient(runId As %String, baseName As %String) As %String
{
    Try {
        Set err = ..GetConfig(runId, baseName, .cfg, .node)
        If err '= "" {
            Return err
        }
        Set className = "ETLWizard.Gen.Rest" _ baseName
        Set landing = "ETLW_LANDING." _ baseName _ "_rest_raw"

        // Landing table for raw JSON payloads (spec §6.1)
        Do ##class(ETLWizard.Tools.Util).RunDDL(
            "CREATE TABLE " _ landing _ " (payload VARCHAR(30000), etl_run_id VARCHAR(64), etl_load_ts TIMESTAMP, etl_source VARCHAR(128))")

        Set nl = $Char(10)
        Set src = "/// Generated by the ETL Wizard: cursor-paginated REST client for '" _ baseName _ "'." _ nl
        Set src = src _ "/// Lands raw JSON items into " _ landing _ ". Re-runnable without the agent." _ nl
        Set src = src _ "Class " _ className _ " Extends %RegisteredObject" _ nl _ "{" _ nl _ nl
        Set src = src _ "/// Fetch every page after the given cursor; returns stats JSON or ERROR text." _ nl
        Set src = src _ "ClassMethod FetchAll(runId As %String, startCursor As %String = """") As %String" _ nl
        Set src = src _ "{" _ nl
        Set src = src _ "    Try {" _ nl
        Set src = src _ "        Set cursor = startCursor" _ nl
        Set src = src _ "        Set pages = 0" _ nl
        Set src = src _ "        Set rows = 0" _ nl
        Set src = src _ "        Set lastId = """"" _ nl
        Set src = src _ "        Set execId = runId _ ""-"" _ $Increment(^ETLWizard.ExecSeq)" _ nl
        Set src = src _ "        For {" _ nl
        Set src = src _ "            Set http = ##class(%Net.HttpRequest).%New()" _ nl
        Set src = src _ "            Set http.Server = """ _ cfg.serverHost _ """" _ nl
        Set src = src _ "            Set http.Port = " _ cfg.serverPort _ nl
        Set src = src _ "            Do http.SetParam(""" _ cfg.cursorParam _ """, $Select(cursor = """": 0, 1: cursor))" _ nl
        Set src = src _ "            Do http.SetParam(""" _ cfg.sizeParam _ """, " _ cfg.pageSize _ ")" _ nl
        Set src = src _ "            Set sc = http.Get(""" _ cfg.path _ """)" _ nl
        Set src = src _ "            If $$$ISERR(sc) {" _ nl
        Set src = src _ "                Return ""ERROR: "" _ $System.Status.GetErrorText(sc)" _ nl
        Set src = src _ "            }" _ nl
        Set src = src _ "            If http.HttpResponse.StatusCode '= 200 {" _ nl
        Set src = src _ "                Return ""ERROR: HTTP "" _ http.HttpResponse.StatusCode" _ nl
        Set src = src _ "            }" _ nl
        Set src = src _ "            Set body = ##class(%DynamicObject).%FromJSON(http.HttpResponse.Data)" _ nl
        Set src = src _ "            Set items = body.%Get(""" _ cfg.dataPath _ """)" _ nl
        Set src = src _ "            If '$IsObject(items) {" _ nl
        Set src = src _ "                Quit" _ nl
        Set src = src _ "            }" _ nl
        Set src = src _ "            Set iter = items.%GetIterator()" _ nl
        Set src = src _ "            While iter.%GetNext(.i, .item) {" _ nl
        Set src = src _ "                Set res = ##class(ETLWizard.Tools.Util).RunDML(" _ nl
        Set src = src _ "                    ""INSERT INTO " _ landing _ " (payload, etl_run_id, etl_load_ts, etl_source) VALUES (?, ?, CURRENT_TIMESTAMP, ?)""," _ nl
        Set src = src _ "                    item.%ToJSON(), execId, """ _ cfg.path _ """)" _ nl
        Set src = src _ "                If $Extract(res, 1, 5) = ""ERROR"" {" _ nl
        Set src = src _ "                    Return res" _ nl
        Set src = src _ "                }" _ nl
        Set src = src _ "                Set rows = rows + 1" _ nl
        Set src = src _ "                Set lastId = item.%Get(""" _ cfg.%Get("idField", "customer_id") _ """, lastId)" _ nl
        Set src = src _ "            }" _ nl
        Set src = src _ "            Set pages = pages + 1" _ nl
        Set src = src _ "            Set cursor = body.%Get(""" _ cfg.cursorField _ """, """")" _ nl
        Set src = src _ "            If cursor = """" {" _ nl
        Set src = src _ "                Quit" _ nl
        Set src = src _ "            }" _ nl
        Set src = src _ "            If pages > 1000 {" _ nl
        Set src = src _ "                Return ""ERROR: page limit exceeded (bad cursor loop?)""" _ nl
        Set src = src _ "            }" _ nl
        Set src = src _ "        }" _ nl
        Set src = src _ "        Return {""pages"": (pages), ""rowsLanded"": (rows), ""lastItemId"": (lastId), ""execId"": (execId)}.%ToJSON()" _ nl
        Set src = src _ "    } Catch ex {" _ nl
        Set src = src _ "        Return ""ERROR: "" _ ex.DisplayString()" _ nl
        Set src = src _ "    }" _ nl
        Set src = src _ "}" _ nl _ nl _ "}" _ nl

        Set stream = ##class(%Stream.TmpCharacter).%New()
        Do stream.Write(src)
        Set sc = $System.OBJ.LoadStream(stream, "ck-d", .errLog, .loaded)
        If $$$ISERR(sc) {
            Return "ERROR compiling client: " _ $System.Status.GetErrorText(sc)
        }
        Set node.CodeRef = className
        Set node.SqlText = src
        Set node.GraphStatus = "generated"
        Do node.%Save()
        Do ##class(ETLWizard.Model.Event).Append(runId, "node.status", node.%Id(),
            {"nodeId": (node.%Id()), "name": (node.Name), "status": "generated", "codeRef": (className)})
        Return "Generated and compiled " _ className _ " landing into " _ landing _ ". Run it with RunRestCursorLoad."
    } Catch ex {
        Return "ERROR: " _ ex.DisplayString()
    }
}

/// REST Cursor Incremental Load (spec §7): executes the generated client,
/// resuming from the pipeline watermark (last cursor); advances the
/// watermark on success only.
Method RunRestCursorLoad(runId As %String, baseName As %String) As %String
{
    Try {
        Set err = ..GetConfig(runId, baseName, .cfg, .node)
        If err '= "" {
            Return err
        }
        Set className = "ETLWizard.Gen.Rest" _ baseName
        Set run = ##class(ETLWizard.Model.Run).%OpenId(runId)
        If '$IsObject(run) {
            Return "ERROR: run not found: " _ runId
        }
        Set prevCursor = ""
        Set wmObj = ##class(ETLWizard.Model.Watermark).PipelineIdxOpen(run.Pipeline.%Id())
        If $IsObject(wmObj) {
            Set prevCursor = wmObj.LastValue
        }
        Set landing = "ETLW_LANDING." _ baseName _ "_rest_raw"
        Do ##class(ETLWizard.Model.Event).Append(runId, "node.status", "", {"name": (landing), "status": "running"})
        Set result = $ClassMethod(className, "FetchAll", runId, prevCursor)
        If $Extract(result, 1, 5) = "ERROR" {
            Do ##class(ETLWizard.Model.Event).Append(runId, "node.status", "", {"name": (landing), "status": "failed", "error": (result)})
            Return result
        }
        Set stats = ##class(%DynamicObject).%FromJSON(result)
        Do ##class(ETLWizard.Model.Event).Append(runId, "node.status", "",
            {"name": (landing), "status": "succeeded", "rowCount": (stats.rowsLanded)})
        // Advance the cursor watermark on success only (spec §7): the client
        // reports the id of the last item it actually landed
        If (stats.rowsLanded > 0) {
            Set newWm = stats.%Get("lastItemId", "")
            If newWm '= "" {
                If '$IsObject(wmObj) {
                    Set wmObj = ##class(ETLWizard.Model.Watermark).%New()
                    Set wmObj.Pipeline = run.Pipeline
                    Set wmObj.Type = "numeric"
                    Set wmObj.ColumnName = cfg.cursorParam
                }
                Set wmObj.LastValue = newWm
                Set wmObj.UpdatedByRun = run
                Set wmObj.UpdatedAt = $ZDateTime($ZTimeStamp, 3, , 3)
                Set sc = wmObj.%Save()
                If $$$ISOK(sc) {
                    Do ##class(ETLWizard.Model.Event).Append(runId, "watermark.updated", "",
                        {"column": (cfg.cursorParam), "previous": (prevCursor), "current": (newWm)})
                }
                Set stats.newWatermark = newWm
            }
        }
        Set stats.strategy = "rest_cursor"
        Set stats.previousWatermark = prevCursor
        Return stats.%ToJSON()
    } Catch ex {
        Return "ERROR: " _ ex.DisplayString()
    }
}

ClassMethod FetchPage(cfg As %DynamicObject, cursor As %String, Output items As %DynamicArray, Output nextCursor As %String) As %String [ Internal, Private ]
{
    Set items = []
    Set nextCursor = ""
    Try {
        Set http = ##class(%Net.HttpRequest).%New()
        Set http.Server = cfg.serverHost
        Set http.Port = cfg.serverPort
        Do http.SetParam(cfg.cursorParam, $Select(cursor = "": 0, 1: cursor))
        Do http.SetParam(cfg.sizeParam, cfg.pageSize)
        Set sc = http.Get(cfg.path)
        If $$$ISERR(sc) {
            Return "ERROR: " _ $System.Status.GetErrorText(sc)
        }
        If http.HttpResponse.StatusCode '= 200 {
            Return "ERROR: HTTP " _ http.HttpResponse.StatusCode _ " from " _ cfg.path
        }
        Set body = ##class(%DynamicObject).%FromJSON(http.HttpResponse.Data)
        Set items = body.%Get(cfg.dataPath)
        If '$IsObject(items) {
            Set items = []
        }
        Set nextCursor = body.%Get(cfg.cursorField, "")
        Return ""
    } Catch ex {
        Return "ERROR: " _ ex.DisplayString()
    }
}

/// Load the stored rest_client config node for baseName.
ClassMethod GetConfig(runId As %String, baseName As %String, Output cfg As %DynamicObject, Output node As ETLWizard.Model.Node) As %String [ Internal, Private ]
{
    Set cfg = ""
    Set node = ""
    Set run = ##class(ETLWizard.Model.Run).%OpenId(runId)
    If '$IsObject(run) {
        Return "ERROR: run not found: " _ runId
    }
    Set node = ##class(ETLWizard.Model.Node).PipelineNameIdxOpen(run.Pipeline.%Id(), baseName _ "_rest_source")
    If '$IsObject(node) {
        Return "ERROR: no REST config stored - call StoreRestConfig first"
    }
    Try {
        Set cfg = ##class(%DynamicObject).%FromJSON(node.ConfigJson)
    } Catch {
        Return "ERROR: stored REST config is not valid JSON"
    }
    Return ""
}

}
